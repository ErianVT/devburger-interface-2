{
	"$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": false,
		"includes": [
			"**",
			"!**/public",
			"!**/dist"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"a11y": {
				"noLabelWithoutControl": "off"
			},
			"correctness": {
				"useHookAtTopLevel": "error",
				"useExhaustiveDependencies": "warn",
				"noUnusedVariables": "warn"
			}
		}
	},
	"javascript": {
		"experimentalEmbeddedSnippetsEnabled": true,
		"formatter": {
			"quoteStyle": "single",
			"semicolons": "asNeeded"
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": {
					"level": "on",
					"options": {
						"groups": [
							[
								"react",
								"react/**",
								"react-*",
								"react-*/**"
							],
							":BLANK_LINE:",
							[
								":PACKAGE:",
								"!@shared/**"
							],
							":BLANK_LINE:",
							"@shared/**",
							":BLANK_LINE:",
							[
								":ALIAS:",
								":PATH:"
							]
						]
					}
				}
			}
		}
	}
}